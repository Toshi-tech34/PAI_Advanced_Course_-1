<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="peg">
    <!-- 物理スリープ(途中傾斜フリーズ)を完全禁止：常に重力演算を継続 -->
    <allow_auto_disable>false</allow_auto_disable>
    <link name="link">
      <!-- 物理特性：理論円柱慣性モーメント (m=0.05kg, r=0.015m, h=0.08m) -->
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>2.95e-5</ixx>
          <iyy>2.95e-5</iyy>
          <izz>5.63e-6</izz>
        </inertia>
      </inertial>
      <!-- 衝突判定：アームで把持するための円柱 -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <!-- 摩擦および反発接触剛性を適正化し、沈み込みと不自然な固着を防止 -->
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <!-- 描画設定：視認しやすい赤色 -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
