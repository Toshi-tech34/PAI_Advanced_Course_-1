<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="side_camera">
    <static>true</static>
    <pose>0.20 -0.45 1.15 0 0.10 1.5708</pose>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.1</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>side_camera/image_raw</topic>
      </sensor>
    </link>
  </model>
</sdf>
